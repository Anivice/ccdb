# Command prompt auto-completion script for GNU readline

{
    < help  (Show this help message):    [NONE] >,
    < quit  (Quit the program):     [NONE] >,
    < exit  (Quit the program):     [NONE] >,
    < get   (Pull information):
        latency             (Latency of an endpoint),
        proxy               (Proxy list),
        < connections       (Active connections):
            < hide          (Hide the column):
                                        0   (Host),
                                        1   (Process),
                                        2   (DL),
                                        3   (UP),
                                        4   (DL Speed),
                                        5   (UP Speed),
                                        6   (Rules),
                                        7   (Time),
                                        8   (Source IP),
                                        9   (Destination IP),
                                        10  (Type),
                                        11  (Chains),
            >,
            shot        (Use pager and pull the active connections once),
        >,
        mode            (Proxy mode),
        log             (Active backend logs),
        vecGroupProxy   (Vector proxy groups),
        filter          (Currently recorded filter),
    >,
    < set (Set parameters): < mode          (Proxy mode):           global (Global mode), rule (Rule mode), direct (Direct mode) >,
                            < group         (Switch proxy group):   [GROUP] (Group name), [PROXY] (Proxy endpoint name) >,
                            < vgroup        (Vector group):         [VGROUP] (Group vector number), [VPROXY] (Proxy vector number) >,
                            < chain_parser  (Chain parser):         on, off >,
                            < sort_by       (Sort by column):
                                                                    0 (Host),
                                                                    1 (Process),
                                                                    2 (DL),
                                                                    3 (UP),
                                                                    4 (DL Speed),
                                                                    5 (UP Speed),
                                                                    6 (Rules),
                                                                    7 (Time),
                                                                    8 (Source IP),
                                                                    9 (Destination IP),
                                                                    10 (Type),
                                                                    11 (Chains),
                            >,
                            < filter        (get connections filter pattern):
                                                                    0 (Host),
                                                                    1 (Process),
                                                                    6 (Rules),
                                                                    8 (Source IP),
                                                                    9 (Destination IP),
                                                                    10 (Type),
                                                                    11 (Chains),
                                                                    12 (Log level),
                                                                    13 (Log content),
                            >, # set filter [INDEX] [PATTERN], pattern cannot be auto completed, so it's simply ignored
                            < sort_reverse  (Reverse sorting):      on, off >,
                            < filter_reverse (Reverse filter):      on, off >,
    >,
    < close_connections (Close all connections): [NONE] >,
    < clear_filter (Clear get connection filtering patterns): [NONE] >,
    < nload (nload-like connection speed monitoring): [NONE] >,
}

