# Command prompt auto-completion script for GNU readline

{
    < help  (Show this help message):       [NONE] >,
    < quit  (Quit the program):             [NONE] >,
    < exit  (Quit the program):             [NONE] >,
    < get   (Pull information):
        latency             (Latency of endpoints),
        proxy               (Proxy list),
        < connection        (Active connections): [NONE] >,
        < connections       (Active connections):
            < hide          (Hide the column):
                                        0   (Host),
                                        1   (Process),
                                        2   (DL),
                                        3   (UP),
                                        4   (DL Speed),
                                        5   (UP Speed),
                                        6   (Rules),
                                        7   (Time),
                                        8   (Source IP),
                                        9   (Destination IP),
                                        10  (Type),
                                        11  (Chains),
            >
        >,
        < memory (Backend memory usage):
            < info (Backend memory info): [NONE] >,
            < pprof (Get backend pprof):
                heap (Current living objects),
                allocs (Allocation profile since start),
                goroutine (Current goroutine stacks),
                threadcreate (OS thread stacks),
                block(Stack traces that led to blocking on synchronization primitives),
                mutex(Stack traces of holders of contended mutexes),
                profile (CPU profile),
                trace (Execution trace),
                cmdline, symbol
            >
        >
        logSize             (Log buffer size),
        mode                (Proxy mode),
        log                 (Active backend logs),
        vecGroupProxy       (Vector proxy groups),
        filter              (Currently recorded filter),
        config              (Get current backend config in JSON),
        filter_reverse      (Filter reverse status),
        sort_reverse        (Sorting reverse status),
        sort_by             (Sorting column),
        < latencyHistory    (Backend latency history): [ENDPOINTS...] >,
        loglevel            (Backend log level),
        rules               (Backend rule list),
        version             (Backend version),
        providerRules       (Provider rules),
    >,
    < set (Set parameters): < mode          (Proxy mode):           global (Global mode), rule (Rule mode), direct (Direct mode) >,
                            < vgroup        (Switch proxy group by vector): [VGROUP] (Group vector number), [VPROXY] (Proxy vector number) >,
                            < chain_parser  (Chain parser):         on (Expand `get connection`'s column 11 chain parser),
                                                                    off (No expansion of `get connection`'s column 11 chain parser)
                            >,
                            < sort_by       (Sort by column):
                                                                    0 (Host),
                                                                    1 (Process),
                                                                    2 (DL),
                                                                    3 (UP),
                                                                    4 (DL Speed),
                                                                    5 (UP Speed),
                                                                    6 (Rules),
                                                                    7 (Time),
                                                                    8 (Source IP),
                                                                    9 (Destination IP),
                                                                    10 (Type),
                                                                    11 (Chains),
                            >,
                            < filter        (get connections/logs filter pattern):
                                                                    0 (Host),
                                                                    1 (Process),
                                                                    6 (Rules),
                                                                    8 (Source IP),
                                                                    9 (Destination IP),
                                                                    10 (Type),
                                                                    11 (Chains),
                                                                    12 (Log level),
                                                                    13 (Log content),
                            >, # set filter [INDEX] [PATTERN], pattern cannot be auto completed, so it's simply ignored
                            < sort_reverse  (Reverse sorting):      on (reverse), off (no reverse) >,
                            < filter_reverse (Reverse filter):      on (reverse), off (no reverse) >,
                            port        (Mihomo http proxy port),
                            socksport   (Mihomo socks5 proxy port),
                            redirport   (Mihomo redirect port),
                            tproxyport  (Mihomo transparent proxy port),
                            mixedport   (Mihomo mixed proxy port),
                            < allowlan  (Allow LAN connections): on, off >,
                            < loglevel  (Mihomo backend log level): silent, debug, info, warning, error >,
                            logSize     (Log buffer size),
    >,
    < closeConnections (Close all connections): [NONE] >,
    < clearFilter (Clear get connection/log filtering patterns): [NONE] >,
    < nload (nload-like connection speed monitoring): logcat (Show last three logs instead of top three speed connections) >,
    < reset (Reset terminal mode): [NONE] >,
    < apply (Apply JSON config to backend): [NONE] >,
    < ? (Print help): [NONE] >,
    < mapProxyChain (Map out current proxy chain): [NONE] >,
    < ccdbrc (Print an example version of the ~/.ccdbrc): [NONE] >,
    < [ALIAS]: [ALIAS_ARGUMENT...] >,
    < clearLogs (Clear logs in the cache): [NONE] >,
    < restartContinuousUpdates (Restart background continuous update workers): [NONE] >,
    < upgrade (Upgrade backend):
        < core (Upgrade core): release, alpha >,
        < geo (Upgrade geoip): [NONE] >,
        < providerRules (Upgrade provider rules) : [NONE] >,
    >,
    < restart (Restart backend): [NONE] >,
    < flush (Flush fake-ip cache): [NONE] >,
    < reload (Reload configuration): [NONE] >, # reload configuration, can be provided by `reload [PATH]`
    < gc (Perform garbage collection for backend): [NONE] >,
    < storage (Backend storage): store (store data), retrieve (retrieve data), delete (delete data) >, # 1> store #name
    < setRuleAffinity (Enable or disable a rule): [NONE] >, # changeRuleAffinity 1,enable 2,disable 4-10,disable
}

