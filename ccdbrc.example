```
DefaultColorScheme = MonoColor

[Shortcut]
KillConn = k
ShowDetail = p
Focus = f
MoveLeft = ^[[D
MoveRight = ^[[C
MoveUp = ^[[A
MoveDown = ^[[B
ToStart = ^[[H
ToEnd = ^[[F
PageUp = ^[[5~
PageDown = ^[[6~
SortBy0 = ^[OP
SortBy1 = ^[OQ
SortBy2 = ^[OR
SortBy3 = ^[OS
SortBy4 = ^[[15~
SortBy5 = ^[[17~
SortBy6 = ^[[18~
SortBy7 = ^[[19~
SortBy8 = ^[[20~
SortBy9 = ^[[21~
SortBy10 = ^[[23~
SortBy11 = ^[[24~
HighlightUP = ^[[1;5A
HighlightDown = ^[[1;5B

[Alias]

# Comments for each line of the alias will be recorded and added to readline prompt as help text

dashboard = get connections # clash dashboard
logs = get log # show logs
