[Global]
ReverseFilter = off     # Reverse the `get connections/get log` filter
SortReverse = off       # Reverse `get connections` sorting
ChainParser = on        # Chain parser for `get connections` column 11
SortBy = 4              # Sort by which column for `get connections`
ReverseMouse = off      # Reverse mouse scrolling
RefreshIntervalMS = 500 # Screen refresh intervals for `get log/nload/get connections`
logSize = 4096          # Buffer size of `get log`

[Filter]
Host = .*
Process = .*
Rules = .*
SourceIP = .*
DestinationIP = .*
Type = .*
Chains = .*
logLevel = .*
logContent = .*

[clash]
link = http://MY SUBSCRIPTION LINK
log = %HOME%/.cache/ccdb/mihomo.log
sslCert = /etc/ssl/cert.pem
sslVerify = on          # This will override DISABLE_SERVER_CERTIFICATE_VERIFICATION=true, but only for subscription links
metricPullerCommand = %HOME%/.local/bin/serverinfo.sh
# the above command should output info in JSON in the format of:
# { "total_uploaded": NUM, "total_downloaded": NUM, "quota": NUM, "expire_unix_timestamp": NUM }
# total_uploaded, total_downloaded, quota are all bytes (and obviously, as numbers)
# expire_unix_timestamp is your server's expiration date, if it has one, in seconds since 1970-01-01:00:00:00, again, as a number
# e.g.: { "total_uploaded": 126164664320, "total_downloaded": 126164664320, "quota": 1073741824000, "expire_unix_timestamp": 1781884800 }
metricPullerCommandTimeOut = 120000 # Time out for either clash link puller, or your custom command, in ms

[ColorScheme]
# offset span will be supplied to $1 as `{ "offset": double, "precision": double }`, with precision being decimal precision
# script/executable must output `{ "Begin": double, "End": double, "R": double, "G": double, "B": double }`
# if offset == -1, or out of bound, R/G/B=0, Begin and End should be a static span.
# offset slides in the span, and the scheme tool should provide corresponding RGB for the specific offset
Scheme1 = %HOME%/.config/ccdb/scheme1.sh
Scheme2 = %HOME%/.config/ccdb/scheme2.sh
MonoColor = ``` # CCDB allows you to embed color scheme inside the config file. This can be done by exporting existing cache
# from the `exportColorScheme` command. The encoding is a base-94 string.
# Do be aware that color scheme cache is very sensitive to the specific implementation of floating points in the FPU.
# This means that different CPU could generate different color scheme cache from exact same color scheme commands.
# This would be useful if it's verifiable that the target FPU recognizes the floating point representation in the desired cache,
# and is too slow to generate the cache, thus serving as a replacement.
# The following cache is an example mono color (Black-white) scheme generated on Intel x86-64
----------------- START OF THE DATA STRUCTURE -----------------
